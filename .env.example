# Скопируйте в .env и заполните. .env в git не попадает.

# Заглушки организаторов (в docker compose переопределяются на имена сервисов)
MOCK_ML_URL=http://127.0.0.1:8001
MOCK_TOIR_URL=http://127.0.0.1:8002
HTTP_TIMEOUT_S=10

# OpenAI-совместимый провайдер. OPENAI_BASE_URL пустой — официальный API OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=
EMBEDDING_MODEL=
VISION_MODEL=

# Пути (относительно корня проекта)
MANUALS_DIR=data/manuals
INDEX_DIR=index
DB_PATH=var/mechanic.sqlite
VEHICLES_PATH=mocks/data/vehicles.json
FAULT_TYPES_PATH=mocks/data/fault_types.json
CONFIG_DIR=config
