# Скопируйте в .env и заполните. .env в git не попадает.

# Заглушки организаторов (в docker compose переопределяются на имена сервисов)
MOCK_ML_URL=http://127.0.0.1:8001
MOCK_TOIR_URL=http://127.0.0.1:8002
HTTP_TIMEOUT_S=10

# OpenAI-совместимый провайдер. OPENAI_BASE_URL пустой — официальный API OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=
EMBEDDING_MODEL=
VISION_MODEL=

# Агент: лимиты цикла (по умолчанию 6 раундов инструментов, 5 фрагментов в выдаче)
AGENT_MAX_TOOL_ROUNDS=6
# Пусто — не передаётся (для chat — reasoning_effort, для responses — reasoning.effort).
AGENT_REASONING_EFFORT=
# chat — Chat Completions (любой OpenAI-совместимый провайдер); responses — Responses API OpenAI
AGENT_API=chat
AGENT_SEARCH_K=5
AGENT_CHUNK_CHARS=2500
AGENT_HISTORY_MESSAGES=12

# Пути (относительно корня проекта)
# База знаний — внешняя: каталоги ВНЕ репозитория (локально, например, ../Digital_mechanic_kb).
# KB_DIR — PDF + манифест kb.yaml (структура — kb.example.yaml); INDEX_DIR — поисковый индекс.
# На стенде: /srv/digital-mechanic/kb и /srv/digital-mechanic/index (в контейнере — /kb и /index).
KB_DIR=
INDEX_DIR=
DB_PATH=var/mechanic.sqlite
VEHICLES_PATH=mocks/data/vehicles.json
FAULT_TYPES_PATH=mocks/data/fault_types.json
CONFIG_DIR=config

# Доступ к интерфейсу и API. Пустой APP_PASSWORD → всё, кроме /health, отвечает 503.
# AUTH_DISABLED=1 — только для локальной разработки, на стенде не ставить.
APP_PASSWORD=
AUTH_DISABLED=0
